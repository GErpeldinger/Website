###< symfony/framework-bundle ###

# Claude Code: personal settings and agent worktrees stay local
/.claude/settings.local.json
/.claude/worktrees/

# Dev tooling (Prettier and later the JS checks), and the Makefile's stamps
/node_modules/
/.make/

# Every tool's cache, one folder each: it survives `docker compose run --rm`, and CI restores it
/.cache/

# The front-end build (Vite): dev writes entrypoints.json there, `vite build` the hashed assets
/public/build/
