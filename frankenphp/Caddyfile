{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/public
	encode zstd br gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	# Space-separated CIDRs allowed in; everyone when unset (empty would let nobody in: compose.yaml
	# covers it). Not in the firewall: Let's Encrypt must stay reachable. Loopback, the healthcheck's
	# source, always passes: published ports arrive from the bridge gateway. no-store beats immutable.
	@denied not client_ip {$SITE_ALLOWLIST:0.0.0.0/0 ::/0} 127.0.0.1/32 ::1/128
	handle @denied {
		header Cache-Control no-store
		respond 403
	}

	# The manifest and entrypoints.json in /build/.vite/ are for PHP only.
	@viteMeta path /build/.vite/*
	respond @viteMeta 404

	# /build/ holds the front-end build: a missing file is a 404, never a Symfony page. In dev, the
	# Vite proxy (CADDY_SERVER_EXTRA_DIRECTIVES) answers it, and the rewrite must not take it first.
	@phpRoute {
		not file {path}
		not path /build/*
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	file_server {
		hide *.php
	}
}
