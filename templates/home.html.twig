{% extends 'base.html.twig' %}

{% block body %}
    <main class="l-stage" data-controller="game" data-game-lines-value="{{ game_lines(app.locale) }}">
        <header class="l-stack">
            <p class="u-step-1 u-weight-medium u-text-muted" data-physics="block" data-weight="light">{{ 'home.greeting'|trans }}</p>
            <h1>{{ include('partials/letters.html.twig', {text: 'site.name'|trans}) }}</h1>
            <p class="u-step-2 u-weight-bold u-leading-tight" data-physics="block" data-weight="light">{{ 'home.role'|trans }}</p>
            <nav aria-label="{{ 'home.links'|trans }}">
                <ul class="l-cluster">
                    <li><a class="pill" href="https://www.linkedin.com/in/guillaumeerpeldinger/" data-physics="link">LinkedIn</a></li>
                    <li><a class="pill" href="https://github.com/GErpeldinger" data-physics="link">GitHub</a></li>
                </ul>
            </nav>
        </header>

        <div class="l-stack">
            <div class="photo" data-physics="block" data-breakable="true">{{ 'home.photo'|trans }}</div>
            <p class="card" data-physics="block" data-breakable="true">{{ 'home.intro'|trans }}</p>

            <section class="board" aria-labelledby="board-title" data-physics="block" data-breakable="true">
                <h2 id="board-title">{{ 'board.title'|trans }}</h2>
                <dl>
                    {{ include('partials/counter.html.twig', {label: 'board.bombs'|trans}) }}
                    {{ include('partials/counter.html.twig', {label: 'board.tornadoes'|trans}) }}
                    {{ include('partials/counter.html.twig', {label: 'board.throws'|trans}) }}
                    {{ include('partials/counter.html.twig', {label: 'board.repairs'|trans}) }}
                    {{ include('partials/counter.html.twig', {label: 'board.online'|trans}) }}
                </dl>
                <p>{{ 'board.note'|trans }}</p>
            </section>
        </div>
    </main>

    {# The visitor's remote. Outside the game's root, which shakes: a fixed box would follow its transform. #}
    <div
        class="dock"
        role="group"
        aria-label="{{ 'dock.label'|trans }}"
        data-controller="dock"
        data-action="game:started@window->dock#start game:stopped@window->dock#stop pointerdown@window->dock#place:capture click@window->dock#swallow:capture keydown@window->dock#escape"
    >
        {% set tool = {'data-dock-target': 'tool', 'data-action': 'dock#select'} %}
        <div class="dock-tools">
            {{ include('partials/dock_tool.html.twig', {icon: 'grab', label: 'dock.grab'|trans, attributes: tool|merge({'aria-pressed': 'true', 'data-pressed': 'true', 'data-dock-tool-param': 'grab'})}) }}
            {{ include('partials/dock_tool.html.twig', {icon: 'bomb', label: 'dock.bomb'|trans, attributes: tool|merge({'aria-pressed': 'false', 'data-pressed': 'false', 'data-dock-tool-param': 'bomb'})}) }}
            {{ include('partials/dock_tool.html.twig', {icon: 'tornado', label: 'dock.tornado'|trans, attributes: tool|merge({'aria-pressed': 'false', 'data-pressed': 'false', 'data-dock-tool-param': 'tornado'})}) }}
            {{ include('partials/dock_tool.html.twig', {icon: 'gravity', label: 'dock.gravity'|trans, attributes: {'aria-pressed': 'false', 'data-pressed': 'false', 'data-dock-target': 'gravity', 'data-action': 'dock#gravity'}}) }}
            {{ include('partials/dock_tool.html.twig', {icon: 'rebuild', label: 'dock.rebuild'|trans, attributes: {'data-emphasis': 'action', 'data-action': 'dock#rebuild'}}) }}
        </div>
    </div>
{% endblock %}
