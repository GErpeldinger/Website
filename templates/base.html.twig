<!DOCTYPE html>
<html lang="{{ app.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ 'site.name'|trans }}{% endblock %}</title>
        {% if app.current_route %}
            {% set route = app.current_route|trim %}
            {% set params = app.current_route_parameters %}
            <link rel="canonical" href="{{ url(route, params) }}">
            {% for locale in locales %}
                <link rel="alternate" hreflang="{{ locale }}" href="{{ url(route, params|merge({_locale: locale})) }}">
            {% endfor %}
            <link rel="alternate" hreflang="x-default" href="{{ url('root') }}">
        {% endif %}
        {{ vite_entry_link_tags('app') }}
        {{ vite_entry_script_tags('app') }}
    </head>
    <body>
        <div class="scene">
            {# The slot for the game's background, behind the content. #}
            <div class="backdrop" aria-hidden="true"></div>
            <div class="ground" aria-hidden="true" data-ground></div>
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
